// Betcha — Postgres (Neon).
//
// The schema avoids enums, scalar arrays, Json and native @db. types, which is
// what made the move from SQLite a provider flip rather than a rewrite. Keep it
// that way unless there is a reason not to.
//
// schema.prisma and src/lib/auth.ts both name the provider and must change
// together. A mismatch fails every request: P1012 at the Prisma layer, or a
// silent adapter mismatch at the Better Auth layer.
//
// MONEY IS INTEGER CENTS. balance, proposerLiability, amount, balanceAtEntry and
// payout are all Int. Elo ratings, probabilities and multipliers are genuinely
// continuous and stay Float. Nothing stores a fractional amount of money.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon gives two URLs. Migrations and introspection need a DIRECT connection;
  // the pooled one goes through PgBouncer, which cannot run them.
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model Circle {
  id          String       @id @default(cuid())
  name        String
  inviteCode  String       @unique
  createdAt   DateTime     @default(now())
  memberships Membership[]
  bets        Bet[]
}

// A User row is NEVER deleted. Account deletion scrubs the identity columns in
// place and leaves the ledger untouched — see src/lib/account-deletion.ts for
// why, and src/lib/auth.ts for the hooks that do it. Every ledger relation
// below is onDelete: Restrict so that a stray user.delete() fails loudly
// instead of quietly taking other members' money history with it.

model User {
  id             String       @id @default(cuid())
  name           String
  avatarSeed     String       @default("")
  createdAt      DateTime     @default(now())
  // Set when the person deletes their account. The row survives, scrubbed;
  // this is the marker that says so. Null for a live account.
  deletedAt      DateTime?
  memberships    Membership[]
  positions      Position[]
  ratings        Rating[]
  votes          Vote[]
  betsCreated    Bet[]        @relation("creator")
  betsAsSubject  Bet[]        @relation("subject")
  betsAsOpponent Bet[]        @relation("opponent")
  email          String
  emailVerified  Boolean      @default(false)
  image          String?
  updatedAt      DateTime     @updatedAt
  sessions       Session[]
  accounts       Account[]

  @@unique([email])
  @@map("user")
}

// Balance is per-circle: currency never crosses circles. So is the forecasting
// rating — how well you call OTHER people's bets. It is not skill, and unlike
// balance it cannot be inflated by betting more or being rich.

model Membership {
  id           String   @id @default(cuid())
  userId       String
  circleId     String
  balance      Int      @default(12000) // cents. $120, matching STARTING_BALANCE.
  forecastElo  Float    @default(1200)
  forecastBets Int      @default(0)
  joinedAt     DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  circle       Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@unique([userId, circleId])
}

// SKILL rating: how good this person is at the thing, per category.
// This is what prices bets ABOUT them. It is not a forecasting rating.

model Rating {
  id       String @id @default(cuid())
  userId   String
  category String // grades | sports | dares | custom
  elo      Float  @default(1200)
  wins     Int    @default(0)
  losses   Int    @default(0)
  user     User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, category])
}

// The opponent for solo bets. Carries its own rating and self-calibrates
// across the circle every time it resolves, like a chess puzzle rating.

model ChallengeTemplate {
  id            String   @id @default(cuid())
  category      String
  text          String // "{subject} gets an A on the next {thing}"
  difficultyElo Float    @default(1200)
  timesUsed     Int      @default(0)
  createdAt     DateTime @default(now())
  bets          Bet[]
}

// Side A is always "the subject succeeds". Side B is always "they don't".

model Bet {
  id         String  @id @default(cuid())
  circleId   String
  creatorId  String
  subjectId  String
  opponentId String? // set for head-to-head bets; null for solo-vs-challenge
  templateId String? // set for solo-vs-challenge bets
  title      String
  category   String
  sideALabel String
  sideBLabel String

  // The proposer picks a SIDE and backs it with the most they are willing to
  // lose, escrowed from their balance. Everyone else can only take the other
  // side. Not live until at least one person does.
  proposerSide      String @default("B") // A | B
  proposerLiability Int    @default(2500) // cents

  // Frozen at creation so the demo can always show what the line was and why.
  subjectElo    Float
  difficultyElo Float // opponent's elo, or the challenge template's elo
  openingProbA  Float

  deadline           DateTime
  resolutionDeadline DateTime
  status             String   @default("pending") // pending | open | voting | resolved | void
  createdAt          DateTime @default(now())

  circle     Circle             @relation(fields: [circleId], references: [id], onDelete: Cascade)
  // Restrict is stated rather than left implicit. creator/subject already
  // defaulted to it, but `opponent` is optional and so defaulted to SetNull —
  // which would have silently blanked the opponent out of a head-to-head other
  // members still hold positions on. A user row is never deleted anyway; this
  // is the database refusing to be the thing that breaks the ledger.
  creator    User               @relation("creator", fields: [creatorId], references: [id], onDelete: Restrict)
  subject    User               @relation("subject", fields: [subjectId], references: [id], onDelete: Restrict)
  opponent   User?              @relation("opponent", fields: [opponentId], references: [id], onDelete: Restrict)
  template   ChallengeTemplate? @relation(fields: [templateId], references: [id])
  positions  Position[]
  resolution Resolution?
  eloEvents  EloEvent[]

  @@index([circleId, status])
}

model Position {
  id                String   @id @default(cuid())
  betId             String
  userId            String
  side              String // A | B
  amount            Int      // cents
  probAtEntry       Float // implied probability of the side taken
  multiplierAtEntry Float
  balanceAtEntry    Int      @default(0) // cents. Bankroll at placement, for conviction weighting.
  payout            Int?     // cents
  createdAt         DateTime @default(now())
  bet               Bet      @relation(fields: [betId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([betId, userId])
  @@index([betId])
}

model Resolution {
  id              String   @id @default(cuid())
  betId           String   @unique
  method          String // evidence | vote
  finalOutcome    String // A | B | void
  evidenceUrl     String?
  sparkClaim      String?
  sparkConfidence Float?
  disputed        Boolean  @default(false)
  resolvedAt      DateTime @default(now())
  bet             Bet      @relation(fields: [betId], references: [id], onDelete: Cascade)
  votes           Vote[]
}

// Only members with no position in the bet may vote.

model Vote {
  id           String     @id @default(cuid())
  resolutionId String
  userId       String
  side         String // A | B
  createdAt    DateTime   @default(now())
  resolution   Resolution @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([resolutionId, userId])
}

// Audit trail so the demo can show a rating moving and say exactly why.

model EloEvent {
  id         String   @id @default(cuid())
  betId      String
  userId     String?
  templateId String?
  category   String
  before     Float
  after      Float
  createdAt  DateTime @default(now())
  bet        Bet      @relation(fields: [betId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
