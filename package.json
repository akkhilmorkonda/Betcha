{
  "name": "betcha",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w apps/api",
    "dev": "npm run dev -w apps/api",
    "start": "npm run start -w apps/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:seed": "npm run db:seed -w apps/api",
    "seed:sim": "npm run seed:sim -w apps/api",
    "demo:numbers": "npm run demo:numbers -w apps/api",
    "spark:check": "npm run spark:check -w apps/api",
    "studio": "npm run studio -w apps/api"
  }
}
