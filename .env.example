# --- Database ----------------------------------------------------------
# Postgres now, not SQLite. A hosted branch (Neon, Supabase, Railway) or a
# local instance both work; production needs a hosted one anyway.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Better Auth -------------------------------------------------------
# Generate the secret with:  npx auth@latest secret
# A weak value makes Better Auth warn at boot about low entropy.
BETTER_AUTH_SECRET="generate-me"
BETTER_AUTH_URL="http://localhost:3000"

# Sign in with Apple. Not provisionable until there's a real HTTPS domain —
# Apple rejects localhost callbacks outright.
# APPLE_CLIENT_ID=""        # Service ID, for the web flow
# APPLE_CLIENT_SECRET=""    # ES256 JWT you sign from the .p8 key
# APPLE_BUNDLE_ID=""        # native iOS client id

# --- Muse Spark (Meta Model API) ---
# Paste your key here whenever you have it. Everything works without it:
# with no key set, evidence submission falls straight to a circle vote.
MUSE_SPARK_API_KEY="paste-key-here"
MUSE_SPARK_BASE_URL="https://api.meta.ai/v1"
MUSE_SPARK_MODEL="muse-spark-1.3"

# There is deliberately no confidence threshold here. A real response came back
# at 0.99 confidence with verdict "unclear" — the float measures how sure the
# model is about what it SEES, not whether the bet is settled. The verdict enum
# is the gate. See src/lib/spark.ts.
