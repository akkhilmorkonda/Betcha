DATABASE_URL="file:./dev.db"

# --- Muse Spark (Meta Model API) ---
# Paste your key here whenever you have it. Everything works without it:
# with no key set, evidence submission falls straight to a circle vote.
MUSE_SPARK_API_KEY="paste-key-here"
MUSE_SPARK_BASE_URL="https://api.meta.ai/v1"
MUSE_SPARK_MODEL="muse-spark-1.3"

# There is deliberately no confidence threshold here. A real response came back
# at 0.99 confidence with verdict "unclear" — the float measures how sure the
# model is about what it SEES, not whether the bet is settled. The verdict enum
# is the gate. See src/lib/spark.ts.
